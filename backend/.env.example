DB_URL=jdbc:postgresql://localhost:5432/equio
DB_APP_USERNAME=equio_app
DB_APP_PASSWORD=replace-with-a-random-app-password
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=replace-with-your-local-admin-password
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_BASE64=replace-with-output-of-openssl-rand-base64-64
METADATA_HASH_KEY_BASE64=replace-with-a-different-output-of-openssl-rand-base64-64
JWT_ISSUER=equio-api
JWT_AUDIENCE=equio-web
JWT_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_DAYS=30
COOKIE_SECURE=false
REQUIRE_HTTPS=false
SWAGGER_PUBLIC=true
UNSPLASH_ACCESS_KEY=
REPORT_MAX_MOVEMENTS=2000
REPORT_MAX_CONCURRENT_PDFS=1
SIGN_UP_RATE_LIMIT_PER_MINUTE=5
IMAGE_SEARCH_RATE_LIMIT_PER_MINUTE=30
MOVEMENT_QUERY_MAX_RESULTS=5000
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
HTTP_MAX_THREADS=50
HTTP_MIN_SPARE_THREADS=4
HTTP_MAX_CONNECTIONS=200
HTTP_ACCEPT_COUNT=50
HTTP_MAX_REQUEST_BYTES=32768
HTTP_REQUEST_LOGS=true
SLOW_REQUEST_MS=2000
